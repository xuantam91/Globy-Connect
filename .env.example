# Xiaozhi Lite Connect Configuration Example
# Copy this file to '.env' and fill in your actual credentials.

# SQLAlchemy Database Connection URL
# For local testing, defaults to sqlite:///./xiaozhi_lite.db
# For production (Supabase PostgreSQL), configure it like this:
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres

# Optional Supabase API credentials
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_KEY=your-supabase-anon-key
